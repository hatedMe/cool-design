{
  "$schema": "https://unpkg.com/release-it@14/schema/release-it.json",
  "increment": "minor",
  "hooks": {
    "after:bump": "pnpm build"
  },
  "git": {
    "commit": true,
    "commitMessage": "chore(release): v${version} [skip ci]",
    "tag": false,
    "push": true
  },
  "npm": {
    "publish": true,
    "skipChecks": true
  },
  "github": {
    "release": false
  }
}
