{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": false,
    "types": [],
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsxImportSource": "declaration-jsx",
    "paths": {
      "vue": ["./node_modules/vue"],
      "declaration-jsx/jsx-runtime": ["./jsx-runtime.d.ts"]
    },
    "rootDir": "../..",
    "outDir": "../../es"
  },
  "include": ["../../packages/cool-design/index.ts", "../../packages/cool-design/hooks.ts", "../../packages/cool-design/*/index.ts"]
}
